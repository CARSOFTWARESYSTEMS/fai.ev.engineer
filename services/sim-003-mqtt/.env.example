# Copy to .env (git-ignored) and fill in real local credentials generated by
# infra/sim-003-mosquitto/scripts/generate-credentials.sh — never commit real values.

SIM003_TRANSPORT=in_memory
SIM003_POC_LOCAL_ONLY=true
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_KEEPALIVE_SECONDS=30
MQTT_QOS=1
MQTT_RETAIN=false
MQTT_TLS=false
MQTT_TOPIC_ROOT=ev-engineer/v1/sim
SIM003_EVENT_BUFFER_LIMIT=5000
SIM003_MAX_EVENTS_PER_RUN=1000

MQTT_PUBLISHER_USERNAME=sim003-publisher
MQTT_PUBLISHER_PASSWORD=changeme-local-only
MQTT_SUBSCRIBER_USERNAME=sim003-subscriber
MQTT_SUBSCRIBER_PASSWORD=changeme-local-only

# Firebase Admin SDK (real ID token verification) — path to a local, git-ignored
# service account JSON. Leave unset + use the dev bypass below for local-only work.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PROJECT_ID=fai-ev-engineer

# Dev-only bypass — NEVER enable outside local loopback development.
SIM003_DEV_AUTH_BYPASS=false
SIM003_DEV_BYPASS_UID=dev-local-user
SIM003_DEV_BYPASS_ORG=demo-organisation
SIM003_DEV_BYPASS_ROLE=engineer

SIM003_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
