rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isOwner(ownerUid) {
      return uid() == ownerUid;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(uid()))
               .data.get('role', 'member');
    }

    // Admin = internal platform admin; does NOT include product Manager role
    function isAdmin() {
      return isAuth() && userRole() in ['admin', 'super_admin'];
    }

    // ManagerOrAbove = product Manager + platform admins; used for project-level gates
    function isManagerOrAbove() {
      return isAuth() && userRole() in ['admin', 'super_admin', 'manager'];
    }

    function isProjectOwner(projectId) {
      return isAuth() &&
        get(/databases/$(database)/documents/projects/$(projectId)).data.uid == uid();
    }

    // ── Partner admin helper ──────────────────────────────────────────────────

    // True if the authenticated user is an active Partner Admin for the given partnerId.
    // Reads partnerAdmins/{uid} — costs one extra read per partner document access.
    function isPartnerAdminForPartner(partnerId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/partnerAdmins/$(uid())) &&
        get(/databases/$(database)/documents/partnerAdmins/$(uid()))
          .data.get('status', '') == 'active' &&
        partnerId in get(/databases/$(database)/documents/partnerAdmins/$(uid()))
          .data.get('partnerIds', []);
    }

    // ── Developer access helpers ──────────────────────────────────────────────

    function isBootstrapDeveloper() {
      return request.auth != null &&
        request.auth.token.email in [
          "sudarshana.karkala@gmail.com",
          "sudhan.infotech@gmail.com",
          "carsoftwaresystems@gmail.com"
        ];
    }

    function isDeveloperInConfig() {
      return isAuth() &&
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/developerConfig/$(request.auth.token.email)) &&
        get(/databases/$(database)/documents/developerConfig/$(request.auth.token.email))
          .data.get('enabled', false) == true;
    }

    function isDeveloper() {
      return isBootstrapDeveloper() || isDeveloperInConfig();
    }

    function isDeveloperAdmin() {
      return isBootstrapDeveloper() || (
        isAuth() &&
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/developerConfig/$(request.auth.token.email)) &&
        get(/databases/$(database)/documents/developerConfig/$(request.auth.token.email))
          .data.get('enabled', false) == true &&
        get(/databases/$(database)/documents/developerConfig/$(request.auth.token.email))
          .data.get('role', 'developer') == 'admin'
      );
    }

    // ── users/{userId} ────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isAuth() && (isOwner(userId) || isAdmin() || isDeveloper());
      // G1: prevent self-escalation — users may only create their doc with role 'engineer'.
      // Admins assign elevated roles via the update path (isAdmin guard above).
      allow create: if isAuth() && isOwner(userId)
                       && request.resource.data.get('role', 'engineer') == 'engineer';
      // Owners can update their own profile fields but cannot change their own role or
      // signup-origin fields (signupDomain, signupHostname, signupBrandingId, signupPartnerCode,
      // signupPartnerName). Those are set once at creation and are read-only afterwards.
      allow update: if isAuth() && (
        (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'signupDomain', 'signupHostname', 'signupBrandingId', 'signupPartnerCode', 'signupPartnerName'
        ]))
        || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ── developerConfig/{email} ───────────────────────────────────────────────
    match /developerConfig/{email} {
      // Self-read always allowed; reading other entries requires developer access.
      allow read:   if (isAuth() && request.auth.token.email == email) || isDeveloper();
      allow create: if isDeveloperAdmin() && request.resource.data.email == email;
      // Admins can update any field.
      // Developers may only update their own entry and cannot change 'role' or 'enabled'.
      allow update: if isDeveloperAdmin()
        || (
          isDeveloper()
          && request.auth.token.email == email
          && !request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasAny(['role', 'enabled'])
        );
      allow delete: if isDeveloperAdmin();
    }

    // ── appConfig/{document} ─────────────────────────────────────────────────
    match /appConfig/{document=**} {
      allow read:  if isAuth();
      allow write: if isDeveloper();
    }

    // ── roleAuditTrail/{eventId} ──────────────────────────────────────────────
    // Append-only role change log. Admins+ may read and create; never update or delete.
    match /roleAuditTrail/{eventId} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if false;
    }

    // ── partners/{partnerId} ─────────────────────────────────────────────────
    // Partner records are read by: Platform Developers, Platform Admins, and
    // the Partner Admin for that specific partner.
    // Only Platform Developers/Admins can create or update partners.
    // Partners are never hard-deleted; use enabled:false to disable.
    match /partners/{partnerId} {
      allow read:   if isDeveloper() || isAdmin() || isPartnerAdminForPartner(partnerId);
      allow create: if isDeveloper()
                       && request.resource.data.get('enabled', true) is bool
                       && request.resource.data.get('name', '') != '';
      allow update: if isDeveloper();
      allow delete: if false;
    }

    // ── partnerAdmins/{uid} ───────────────────────────────────────────────────
    // Stores which partners a user administers.
    // A user can read their own record (to discover which partners they manage).
    // Only Platform Developers/Admins can create/update/delete these records.
    match /partnerAdmins/{adminUid} {
      allow read:   if isDeveloper() || isAdmin() || (isAuth() && uid() == adminUid);
      allow create: if isDeveloper()
                       && request.resource.data.get('uid', '') == adminUid
                       && request.resource.data.get('status', '') in ['active', 'deactivated'];
      allow update: if isDeveloper();
      allow delete: if isDeveloper();
    }

    // ── brandings/{brandingId} ───────────────────────────────────────────────
    // Public read: branding is display-only config (names, contact info, powered-by).
    // It must load before authentication (landing page) and persist after logout.
    // Writes remain developer-only.
    match /brandings/{brandingId} {
      allow read:   if true;
      allow create: if isDeveloper()
                       && request.resource.data.get('createdBy', '') == request.auth.token.email;
      allow update: if isDeveloper();
      allow delete: if isDeveloper();
    }

    // ── productConfigs/{pk} ───────────────────────────────────────────────────
    match /productConfigs/{pk} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── organizationConfigs/{orgCode} ─────────────────────────────────────────
    match /organizationConfigs/{orgCode} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── projects/{projectId} ──────────────────────────────────────────────────

    // Canonical status values — the only strings that may ever be written.
    // 'complete' is intentionally excluded: it is a legacy read-compat value and
    // must never be written by any new code path.
    function isValidStatus(s) {
      return s in ['draft', 'in-progress', 'review', 'completed', 'archived'];
    }

    match /projects/{projectId} {
      allow read:   if isAuth() && (isOwner(resource.data.uid) || isManagerOrAbove());
      // Status must be one of the canonical values on every new document.
      allow create: if isAuth() && isOwner(request.resource.data.uid)
                       && isValidStatus(request.resource.data.status);
      // Managers+ can update any field; if they change status it must be canonical.
      // Engineers (owners) can update basic fields AND can transition status within
      // ['draft','in-progress','review'], but cannot touch priority, dueDate, or
      // move status to/from 'completed'/'archived'.
      // The status allowlist is only checked when status is in the affected keys,
      // preserving backward-compat with legacy 'complete' documents on non-status
      // updates.
      allow update: if isAuth() && (
        (
          isManagerOrAbove()
          // Status allowlist: only canonical values may be written when status changes
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
            || isValidStatus(request.resource.data.status)
          )
          // Review decision allowlist: only valid values may be written
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reviewDecision'])
            || request.resource.data.reviewDecision in ['approved', 'rejected', 'cancelled', 'needs-rework']
          )
        )
        || (
          isOwner(resource.data.uid)
          // Engineers cannot write planning or review/audit fields
          && !request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasAny([
                  'priority', 'dueDate',
                  'reviewDecision', 'reviewComment', 'reviewedBy', 'reviewedAt',
                  'completedAt', 'completedBy', 'archivedAt', 'archivedBy'
                ])
          && (
            !request.resource.data.diff(resource.data)
                  .affectedKeys()
                  .hasAny(['status'])
            || (
              request.resource.data.status in ['draft', 'in-progress', 'review']
              && resource.data.status in ['draft', 'in-progress', 'review']
            )
          )
        )
      );
      allow delete: if isManagerOrAbove() || isOwner(resource.data.uid);

      match /balloons/{balloonId} {
        allow read:   if isProjectOwner(projectId);
        allow create: if isProjectOwner(projectId) &&
                         request.resource.data.createdBy == uid();
        allow update: if isProjectOwner(projectId);
        allow delete: if isProjectOwner(projectId);
      }

      match /features/{featureId} {
        allow read:   if isProjectOwner(projectId);
        allow create: if isProjectOwner(projectId) &&
                         request.resource.data.createdBy == uid();
        allow update: if isProjectOwner(projectId);
        allow delete: if isProjectOwner(projectId);
      }

      match /form3Results/{featureId} {
        allow read:   if isProjectOwner(projectId);
        allow create: if isProjectOwner(projectId) &&
                         request.resource.data.createdBy == uid();
        allow update: if isProjectOwner(projectId);
        allow delete: if isProjectOwner(projectId);
      }

      match /form1/{form1Id} {
        allow read:   if isProjectOwner(projectId);
        allow create: if isProjectOwner(projectId);
        allow update: if isProjectOwner(projectId);
        allow delete: if isProjectOwner(projectId);
      }

      match /form2Rows/{rowId} {
        allow read:   if isProjectOwner(projectId);
        allow create: if isProjectOwner(projectId);
        allow update: if isProjectOwner(projectId);
        allow delete: if isProjectOwner(projectId);
      }

      // Audit trail — append-only; no client updates or deletes ever permitted
      match /auditTrail/{eventId} {
        allow read:   if isAuth() && (isProjectOwner(projectId) || isManagerOrAbove());
        allow create: if isManagerOrAbove();
        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
