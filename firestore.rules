rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isOwner(ownerUid) {
      return uid() == ownerUid;
    }

    // Reads the caller's role from users/{uid}.role.
    // get() inside rules bypasses the rules themselves — no circular dependency.
    function userRole() {
      return get(/databases/$(database)/documents/users/$(uid()))
               .data.get('role', 'member');
    }

    function isAdmin() {
      return isAuth() && userRole() in ['admin', 'super_admin'];
    }

    // Checks that the caller owns the project — used by balloon subcollection.
    function isProjectOwner(projectId) {
      return isAuth() &&
        get(/databases/$(database)/documents/projects/$(projectId)).data.uid == uid();
    }

    // ── Developer access helpers ──────────────────────────────────────────────

    // Hard-coded bootstrap developer emails — always allowed.
    function isBootstrapDeveloper() {
      return request.auth != null &&
        request.auth.token.email in [
          "sudarshana.karkala@gmail.com",
          "sudhan.infotech@gmail.com",
          "carsoftwaresystems@gmail.com"
        ];
    }

    // Checks developerConfig/{email} for an enabled record.
    // Uses get() which bypasses rules at evaluation time — no circular dependency.
    function isDeveloperInConfig() {
      return isAuth() &&
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/developerConfig/$(request.auth.token.email)) &&
        get(/databases/$(database)/documents/developerConfig/$(request.auth.token.email))
          .data.get('enabled', false) == true;
    }

    function isDeveloper() {
      return isBootstrapDeveloper() || isDeveloperInConfig();
    }

    // ── users/{userId} ────────────────────────────────────────────────────────
    match /users/{userId} {
      // Users can read their own profile; admins can read any profile.
      allow read:   if isAuth() && (isOwner(userId) || isAdmin());
      // Only the user themselves can create their own profile document.
      allow create: if isAuth() && isOwner(userId);
      // Users can update their own profile; admins can update any.
      allow update: if isAuth() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // ── developerConfig/{email} ───────────────────────────────────────────────
    // One document per developer, keyed by email address.
    // Read + write restricted to authorised developers only.
    // Delete disabled — use enabled=false to revoke access.
    match /developerConfig/{email} {
      allow read:   if isDeveloper();
      allow create: if isDeveloper() && request.resource.data.email == email;
      allow update: if isDeveloper();
      allow delete: if false;
    }

    // ── appConfig/{document} ─────────────────────────────────────────────────
    // UI notices, feature flags, and other app-wide config.
    // Read by any authenticated user; write restricted to authorised developers.
    match /appConfig/{document=**} {
      allow read:  if isAuth();
      allow write: if isDeveloper();
    }

    // ── productConfigs/{pk} ───────────────────────────────────────────────────
    match /productConfigs/{pk} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── organizationConfigs/{orgCode} ─────────────────────────────────────────
    match /organizationConfigs/{orgCode} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── projects/{projectId} ──────────────────────────────────────────────────
    match /projects/{projectId} {
      // Owner or admin can read a project.
      allow read:   if isAuth() && (isOwner(resource.data.uid) || isAdmin());

      // Any authenticated user can create a project as long as the uid field
      // matches their own auth UID (prevents creating projects on behalf of others).
      allow create: if isAuth() && isOwner(request.resource.data.uid);

      // Owner or admin can update (admin needed for priority/dueDate writes).
      allow update: if isAuth() && (isOwner(resource.data.uid) || isAdmin());

      // Only admins can delete projects (enforced in deleteProject() service too).
      allow delete: if isAdmin();

      // ── projects/{projectId}/balloons/{balloonId} ─────────────────────────
      match /balloons/{balloonId} {
        allow read:   if isProjectOwner(projectId);
        allow create: if isProjectOwner(projectId) &&
                         request.resource.data.createdBy == uid();
        allow update: if isProjectOwner(projectId);
        allow delete: if isProjectOwner(projectId);
      }

      // ── projects/{projectId}/features/{featureId} ─────────────────────────
      match /features/{featureId} {
        allow read:   if isProjectOwner(projectId);
        allow create: if isProjectOwner(projectId) &&
                         request.resource.data.createdBy == uid();
        allow update: if isProjectOwner(projectId);
        allow delete: if isProjectOwner(projectId);
      }

      // ── projects/{projectId}/form3Results/{featureId} ────────────────────
      match /form3Results/{featureId} {
        allow read:   if isProjectOwner(projectId);
        allow create: if isProjectOwner(projectId) &&
                         request.resource.data.createdBy == uid();
        allow update: if isProjectOwner(projectId);
        allow delete: if isProjectOwner(projectId);
      }

      // ── projects/{projectId}/form1/{form1Id} ─────────────────────────────
      match /form1/{form1Id} {
        allow read:   if isProjectOwner(projectId);
        allow create: if isProjectOwner(projectId);
        allow update: if isProjectOwner(projectId);
        allow delete: if isProjectOwner(projectId);
      }

      // ── projects/{projectId}/form2Rows/{rowId} ───────────────────────────
      match /form2Rows/{rowId} {
        allow read:   if isProjectOwner(projectId);
        allow create: if isProjectOwner(projectId);
        allow update: if isProjectOwner(projectId);
        allow delete: if isProjectOwner(projectId);
      }
    }
  }
}
