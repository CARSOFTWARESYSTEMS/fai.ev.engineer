rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isOwner(ownerUid) {
      return uid() == ownerUid;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(uid()))
               .data.get('role', 'member');
    }

    // Admin = internal platform admin; does NOT include product Manager role
    function isAdmin() {
      return isAuth() && userRole() in ['admin', 'super_admin'];
    }

    // ManagerOrAbove = product Manager + platform admins; used for project-level gates
    function isManagerOrAbove() {
      return isAuth() && userRole() in ['admin', 'super_admin', 'manager'];
    }

    function isProjectOwner(projectId) {
      return isAuth() &&
        get(/databases/$(database)/documents/projects/$(projectId)).data.uid == uid();
    }

    function isProjectOwnerAccessible(projectId) {
      return isProjectOwner(projectId) &&
        !(get(/databases/$(database)/documents/projects/$(projectId))
          .data.get('lifecycleStatus', 'active') in [
            'blocked', 'deleted', 'permanently_deleted'
          ]);
    }

    // ── Lifecycle helpers ─────────────────────────────────────────────────────

    // True if the requesting user's lifecycle status prevents access.
    // Uses 'active' as the default if the field is missing.
    // Blocked/deleted users retain read access to their own user doc (used by auth flow).
    function isCurrentUserLifecycleBlocked() {
      return get(/databases/$(database)/documents/users/$(uid()))
        .data.get('lifecycleStatus', 'active') in [
          'blocked',
          'deleted',
          'permanently_deleted'
        ];
    }

    // True if the project document's lifecycle status prevents normal user access.
    // Uses resource.data (already loaded for the current document match).
    function isProjectLifecycleBlocked() {
      return resource.data.get('lifecycleStatus', 'active') in [
        'blocked',
        'deleted',
        'permanently_deleted'
      ];
    }

    // ── Partner admin helper ──────────────────────────────────────────────────

    // True if the requesting user is the owner of the given organisation.
    // Uses the denormalised ownerUid field on the organisations document.
    function isOrgOwner(organisationId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/organisations/$(organisationId)) &&
        get(/databases/$(database)/documents/organisations/$(organisationId))
          .data.get('ownerUid', '') == uid();
    }

    function isPartnerAdminForPartner(partnerId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/partnerAdmins/$(uid())) &&
        get(/databases/$(database)/documents/partnerAdmins/$(uid()))
          .data.get('status', '') == 'active' &&
        partnerId in get(/databases/$(database)/documents/partnerAdmins/$(uid()))
          .data.get('partnerIds', []);
    }

    // ── Developer access helpers ──────────────────────────────────────────────

    function isBootstrapDeveloper() {
      return request.auth != null &&
        request.auth.token.email in [
          "sudarshana.karkala@gmail.com",
          "sudhan.infotech@gmail.com",
          "carsoftwaresystems@gmail.com"
        ];
    }

    function isDeveloperInConfig() {
      return isAuth() &&
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/developerConfig/$(request.auth.token.email)) &&
        get(/databases/$(database)/documents/developerConfig/$(request.auth.token.email))
          .data.get('enabled', false) == true;
    }

    function isDeveloper() {
      return isBootstrapDeveloper() || isDeveloperInConfig();
    }

    function isSuperAdmin() {
      return isBootstrapDeveloper() ||
        (isAuth() && userRole() == 'super_admin');
    }

    function isDeveloperAdmin() {
      return isBootstrapDeveloper() || (
        isAuth() &&
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/developerConfig/$(request.auth.token.email)) &&
        get(/databases/$(database)/documents/developerConfig/$(request.auth.token.email))
          .data.get('enabled', false) == true &&
        get(/databases/$(database)/documents/developerConfig/$(request.auth.token.email))
          .data.get('role', 'developer') == 'admin'
      );
    }

    // ── users/{userId} ────────────────────────────────────────────────────────
    match /users/{userId} {
      // Own doc: always readable (needed for auth flow and blocked-page display).
      // Other docs: require lifecycle is not blocked.
      allow read: if isAuth() && (
        isOwner(userId)
        || ((isAdmin() || isDeveloper()) && !isCurrentUserLifecycleBlocked())
      );
      // G1: prevent self-escalation
      allow create: if isAuth() && isOwner(userId)
                       && request.resource.data.get('role', 'engineer') == 'engineer';
      // Owners can update own profile (no role/signup-origin changes).
      // Admins/Developers can update anything (used for lifecycle state changes).
      allow update: if isAuth() && (
        (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'signupDomain', 'signupHostname', 'signupBrandingId', 'signupPartnerCode', 'signupPartnerName'
        ]))
        || isAdmin()
        || isDeveloper()
      );
      allow delete: if isAdmin() || isDeveloper();
    }

    // ── developerConfig/{email} ───────────────────────────────────────────────
    match /developerConfig/{email} {
      allow read:   if (isAuth() && request.auth.token.email == email) || isDeveloper();
      allow create: if isDeveloperAdmin() && request.resource.data.email == email;
      allow update: if isDeveloperAdmin()
        || (
          isDeveloper()
          && request.auth.token.email == email
          && !request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasAny(['role', 'enabled'])
        );
      allow delete: if isDeveloperAdmin();
    }

    // ── appConfig/{document} ─────────────────────────────────────────────────
    match /appConfig/{document=**} {
      allow read:  if isAuth();
      allow write: if isDeveloper();
    }

    // ── roleAuditTrail/{eventId} ──────────────────────────────────────────────
    match /roleAuditTrail/{eventId} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if false;
    }

    // ── lifecycleAuditTrail/{eventId} ─────────────────────────────────────────
    // Append-only lifecycle change log for users and projects.
    // Only admins and developers may read or create; never update or delete.
    match /lifecycleAuditTrail/{eventId} {
      allow read:   if isAdmin() || isDeveloper();
      allow create: if (isAdmin() || isDeveloper()) && !isCurrentUserLifecycleBlocked();
      allow update: if false;
      allow delete: if false;
    }

    // ── partners/{partnerId} ─────────────────────────────────────────────────
    match /partners/{partnerId} {
      allow read:   if isDeveloper() || isAdmin() || isPartnerAdminForPartner(partnerId);
      allow create: if isDeveloper()
                       && request.resource.data.get('enabled', true) is bool
                       && request.resource.data.get('name', '') != '';
      allow update: if isDeveloper();
      allow delete: if false;
    }

    // ── partnerAdmins/{uid} ───────────────────────────────────────────────────
    // Active records: doc ID = Firebase UID, data.uid = uid.
    // Pending records: doc ID = pending_{email}, data.uid = null (user not yet registered).
    match /partnerAdmins/{adminUid} {
      allow read:   if isDeveloper() || isAdmin() || (isAuth() && uid() == adminUid);
      allow create: if isDeveloper()
                       && (
                         request.resource.data.get('uid', '') == adminUid
                         || (adminUid.matches('pending_.*') && request.resource.data.uid == null)
                       )
                       && request.resource.data.get('status', '') in ['active', 'deactivated', 'pending'];
      allow update: if isDeveloper();
      allow delete: if isDeveloper();
    }

    // ── brandings/{brandingId} ───────────────────────────────────────────────
    // Public read: branding loads before auth and is needed by the blocked-user page.
    match /brandings/{brandingId} {
      allow read:   if true;
      allow create: if isDeveloper()
                       && request.resource.data.get('createdBy', '') == request.auth.token.email;
      allow update: if isDeveloper();
      allow delete: if isDeveloper();
    }

    // ── productConfigs/{pk} ───────────────────────────────────────────────────
    match /productConfigs/{pk} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── organizationConfigs/{orgCode} ─────────────────────────────────────────
    match /organizationConfigs/{orgCode} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── projects/{projectId} ──────────────────────────────────────────────────

    function isValidStatus(s) {
      return s in ['draft', 'in-progress', 'review', 'completed', 'archived'];
    }

    match /projects/{projectId} {
      // Normal users (owners) cannot read lifecycle-blocked projects.
      // Managers, admins, and developers can still read for support/audit.
      allow read: if isAuth() && !isCurrentUserLifecycleBlocked() && (
        (isOwner(resource.data.uid) && !isProjectLifecycleBlocked())
        || isManagerOrAbove()
        || isDeveloper()
      );
      allow create: if isAuth() && isOwner(request.resource.data.uid)
                       && isValidStatus(request.resource.data.status)
                       && !isCurrentUserLifecycleBlocked();
      allow update: if isAuth() && !isCurrentUserLifecycleBlocked() && (
        (
          isManagerOrAbove()
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
            || isValidStatus(request.resource.data.status)
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reviewDecision'])
            || request.resource.data.reviewDecision in ['approved', 'rejected', 'cancelled', 'needs-rework']
          )
        )
        || (
          isOwner(resource.data.uid)
          && !isProjectLifecycleBlocked()
          && !request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasAny([
                  'lifecycleStatus',
                  'blockedAt', 'blockedBy', 'blockedReason',
                  'deletedAt', 'deletedBy', 'deletedReason',
                  'permanentlyDeletedAt', 'permanentlyDeletedBy', 'permanentlyDeletedReason',
                  'priority', 'dueDate',
                  'reviewDecision', 'reviewComment', 'reviewedBy', 'reviewedAt',
                  'completedAt', 'completedBy', 'archivedAt', 'archivedBy'
                ])
          && (
            !request.resource.data.diff(resource.data)
                  .affectedKeys()
                  .hasAny(['status'])
            || (
              request.resource.data.status in ['draft', 'in-progress', 'review']
              && resource.data.status in ['draft', 'in-progress', 'review']
            )
          )
        )
        || isDeveloper()
      );
      // Hard deletes restricted to developer admin only — normal flow uses lifecycleStatus soft-delete.
      allow delete: if isDeveloperAdmin() && !isCurrentUserLifecycleBlocked();

      match /balloons/{balloonId} {
        allow read:   if isProjectOwnerAccessible(projectId) && !isCurrentUserLifecycleBlocked();
        allow create: if isProjectOwnerAccessible(projectId) &&
                         request.resource.data.createdBy == uid() &&
                         !isCurrentUserLifecycleBlocked();
        allow update: if isProjectOwnerAccessible(projectId) && !isCurrentUserLifecycleBlocked();
        allow delete: if isProjectOwnerAccessible(projectId) && !isCurrentUserLifecycleBlocked();
      }

      match /features/{featureId} {
        allow read:   if isProjectOwnerAccessible(projectId) && !isCurrentUserLifecycleBlocked();
        allow create: if isProjectOwnerAccessible(projectId) &&
                         request.resource.data.createdBy == uid() &&
                         !isCurrentUserLifecycleBlocked();
        allow update: if isProjectOwnerAccessible(projectId) && !isCurrentUserLifecycleBlocked();
        allow delete: if isProjectOwnerAccessible(projectId) && !isCurrentUserLifecycleBlocked();
      }

      match /form3Results/{featureId} {
        allow read:   if isProjectOwnerAccessible(projectId) && !isCurrentUserLifecycleBlocked();
        allow create: if isProjectOwnerAccessible(projectId) &&
                         request.resource.data.createdBy == uid() &&
                         !isCurrentUserLifecycleBlocked();
        allow update: if isProjectOwnerAccessible(projectId) && !isCurrentUserLifecycleBlocked();
        allow delete: if isProjectOwnerAccessible(projectId) && !isCurrentUserLifecycleBlocked();
      }

      match /form1/{form1Id} {
        allow read:   if isProjectOwnerAccessible(projectId) && !isCurrentUserLifecycleBlocked();
        allow create: if isProjectOwnerAccessible(projectId) && !isCurrentUserLifecycleBlocked();
        allow update: if isProjectOwnerAccessible(projectId) && !isCurrentUserLifecycleBlocked();
        allow delete: if isProjectOwnerAccessible(projectId) && !isCurrentUserLifecycleBlocked();
      }

      match /form2Rows/{rowId} {
        allow read:   if isProjectOwnerAccessible(projectId) && !isCurrentUserLifecycleBlocked();
        allow create: if isProjectOwnerAccessible(projectId) && !isCurrentUserLifecycleBlocked();
        allow update: if isProjectOwnerAccessible(projectId) && !isCurrentUserLifecycleBlocked();
        allow delete: if isProjectOwnerAccessible(projectId) && !isCurrentUserLifecycleBlocked();
      }

      match /auditTrail/{eventId} {
        allow read:   if isAuth() && (isProjectOwnerAccessible(projectId) || isManagerOrAbove());
        allow create: if isManagerOrAbove();
        allow update: if false;
        allow delete: if false;
      }
    }

    match /projectAccessSummaries/{projectId} {
      allow read: if isAuth() && !isCurrentUserLifecycleBlocked()
                    && resource.data.ownerUid == uid();
      allow create, update: if isAuth() && (isAdmin() || isDeveloper())
        && request.resource.data.keys().hasOnly([
          'projectId', 'ownerUid', 'ownerEmail', 'lifecycleStatus',
          'projectName', 'partNumber', 'status', 'updatedAt',
          'supportDomain', 'supportEmail', 'supportPhone', 'supportWhatsapp'
        ])
        && request.resource.data.projectId == projectId
        && request.resource.data.lifecycleStatus in [
          'active', 'inactive', 'blocked', 'deleted', 'permanently_deleted'
        ];
      allow delete: if false;
    }

    // ── userActivityLogs/{logId} ──────────────────────────────────────────────
    // Append-only activity log written by authenticated users and services.
    // Only super_admin and bootstrap developers may read.
    match /userActivityLogs/{logId} {
      allow read:   if isSuperAdmin();
      allow create: if isAuth() && !isCurrentUserLifecycleBlocked();
      allow update: if false;
      allow delete: if false;
    }

    // ── organisations/{organisationId} ────────────────────────────────────────
    // Platform-admin and bootstrap-developer may read/write all orgs.
    // Partner admins may read and update orgs that belong to their partner.
    // Deletes are soft (status set to 'inactive') — hard deletes not allowed.
    //
    // Subscription editing (Sprint 10):
    //   Editable:  super_admin, admin, partner_super_admin, partner_admin
    //   View-only: bootstrap developer (enforced at UI layer — Firestore allows for org mgmt)
    //   Hidden:    organisation users (no rule grants org-user update access)
    match /organisations/{organisationId} {
      allow read:   if isDeveloper()
                    || isAdmin()
                    || isPartnerAdminForPartner(resource.data.partnerId);
      allow create: if isDeveloper() || isAdmin();
      allow update: if isDeveloper()
                    || isAdmin()
                    || isPartnerAdminForPartner(resource.data.partnerId);
      allow delete: if false;
    }

    // ── organisationMembers/{membershipId} ────────────────────────────────────
    // Platform-admin and bootstrap-developer may read/write all memberships.
    // Org owners may create/update memberships within their organisation.
    // Any member may read their own membership record.
    // Deletes are soft (membershipStatus / active field) — hard deletes not allowed.
    match /organisationMembers/{membershipId} {
      allow read:   if isDeveloper()
                    || isAdmin()
                    || (isAuth() && resource.data.userUid == uid())
                    || isOrgOwner(resource.data.organisationId);
      allow create: if isDeveloper()
                    || isAdmin()
                    || isOrgOwner(request.resource.data.organisationId);
      allow update: if isDeveloper()
                    || isAdmin()
                    || isOrgOwner(resource.data.organisationId);
      allow delete: if false;
    }

    // ── organisationActivityLogs/{logId} ──────────────────────────────────────
    // Append-only activity log for organisation events.
    // Platform admins and org owners may read. Partner admins read via developer/admin sessions.
    // Anyone authenticated and non-lifecycle-blocked may create (actions fire this).
    // Never update or delete — immutable audit trail.
    match /organisationActivityLogs/{logId} {
      allow read:   if isDeveloper()
                    || isAdmin()
                    || isOrgOwner(resource.data.organisationId);
      allow create: if isAuth()
                    && !isCurrentUserLifecycleBlocked()
                    && request.resource.data.keys().hasAll([
                         'organisationId', 'eventType', 'actorUid',
                         'actorEmail', 'description', 'createdAt'
                       ]);
      allow update: if false;
      allow delete: if false;
    }
  }
}
